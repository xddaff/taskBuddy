{
  "name": "studentproj",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,realtime,worker -c cyan,magenta,yellow \"pnpm -F @studentproj/web dev\" \"pnpm -F @studentproj/realtime dev\" \"pnpm -F @studentproj/worker dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm -F @studentproj/db generate",
    "db:migrate": "pnpm -F @studentproj/db migrate",
    "db:push": "pnpm -F @studentproj/db push",
    "db:seed": "pnpm -F @studentproj/worker seed",
    "db:studio": "pnpm -F @studentproj/db studio",
    "gitlab:index": "pnpm -F @studentproj/worker index"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}

# Local SQLite database
DATABASE_URL="file:./dev.db"

# Leave DEMO_MODE unset to auto-detect: the app runs on fixtures until the
# GitLab variables below are filled in. Set to "true" to force fixtures.
DEMO_MODE=true

# GitLab instance (self-hosted works too) and the course project
GITLAB_URL="https://gitlab.com"
GITLAB_PROJECT_ID=""

# OAuth application credentials (scopes: api)
# Redirect URI: http://localhost:3000/api/auth/gitlab/callback
GITLAB_APP_ID=""
GITLAB_APP_SECRET=""

# Base URL used to build the OAuth redirect URI
APP_URL="http://localhost:3000"

# ---- database ----
DATABASE_URL="postgresql://studentproj:studentproj@localhost:5432/studentproj?schema=public"

# ---- auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
AUTH_URL="http://localhost:3000"

# 32-byte key used to encrypt stored GitLab tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-me-with-a-random-32-byte-base64-string"

# ---- gitlab ----
# Your instance. Defaults to gitlab.com so the app runs before you have
# credentials for the university instance.
GITLAB_BASE_URL="https://gitlab.com"

# OAuth application registered on the instance.
# Redirect URI must be exactly: http://localhost:3000/api/auth/callback/gitlab
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# Group access token (scope: read_api) used by the worker to build the shared
# issue index. Without it the worker does nothing and you rely on the seed data.
GITLAB_INDEX_TOKEN=""

# Comma-separated GitLab group paths or numeric ids to index.
# Example: "cs-department/web-projects,cs-department/capstone"
GITLAB_INDEX_GROUPS=""

# Shared secret for the issue webhook receiver (X-Gitlab-Token header).
GITLAB_WEBHOOK_SECRET=""

# ---- realtime ----
REALTIME_PORT="3001"
NEXT_PUBLIC_REALTIME_URL="http://localhost:3001"

# Shared secret the realtime service uses to verify session handoff from web.
REALTIME_SHARED_SECRET="replace-me-with-a-random-string"

# ---- storage ----
# Local disk directory for chat attachments.
UPLOADS_DIR="./uploads"
MAX_UPLOAD_BYTES="10485760"

# ---- development only ----
# Signs in as a seeded student without a password so the app is usable before
# a GitLab OAuth application exists. Ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN="true"
